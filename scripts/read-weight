#!/bin/sh
# What a started session actually read, from its Claude Code transcript (a .jsonl file): the context the
# model held at its first turn (system prompt, skills listed, the session start, the brief), at its first act
# on the work, and at its end - in tokens, as the transcript's own usage says - and the largest things it
# read before that act: each skill loaded, file opened and command's output, in bytes (practice
# 45-keep-the-start-light: measure what is read, not only what lies at the front).
#
#   read-weight TRANSCRIPT [ACT]   ACT: an extended regular expression a Bash command matches when it acts
#                                  on the work (default: a change through devlab, an edit, a record, a landing)
# Then what it was given and never used: the skills, agents, deferred tools and connectors listed, the first
# prompt's hook. A session's transcript is ~/.claude/projects/PROJECT/SESSION.jsonl (the newest for a session started now:
# ls -t ~/.claude/projects/-home-mll/*.jsonl | head). Needs jq. Ends 2 on a wrong call.
set -eu
[ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: read-weight TRANSCRIPT [ACT]" >&2; exit 2; }
t=$1
act=${2:-'devlab (phone (sh|root|put|reboot)|kernel|suite run|suspend|hear)|tad r |land |landit|git commit'}
command -v jq > /dev/null || { echo "read-weight: needs jq" >&2; exit 2; }

jq -rs --arg act "$act" '
  def ctx: (.message.usage // {}) | ((.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0));
  def acts: .type == "assistant" and ([.message.content[]? | select(.type == "tool_use")
      | select(.name == "Edit" or .name == "Write" or (.name == "Bash" and (.input.command | test($act))))] | length > 0);
  def sized: if type == "string" then length else (tostring | length) end;
  def ts: .timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdate;
  . as $all
  | ([$all[] | select(.type == "assistant" and ctx > 0)]) as $turns
  | ([range(0; $all | length) | select($all[.] | acts)] | first) as $at
  | ($all[0:($at // ($all | length))]) as $before
  | ([$before[] | select(.type == "assistant") | .message.content[]? | select(.type == "tool_use")
      | {key: .id, value: (.name + " " + ((.input.skill // .input.file_path // .input.command // .input.query // "") | tostring | gsub("\n"; " ") | .[0:70]))}]
      | from_entries) as $calls
  | ([$before[] | select(.type == "user") | .message.content | arrays | .[] | select(.type == "tool_result")
      | {what: ($calls[.tool_use_id] // "?"), bytes: (.content | sized)}]) as $reads
  | ([$all[] | select(.type == "attachment" and .attachment.hookEvent == "SessionStart") | .attachment.content | sized] | add // 0) as $start
  | ([$all[] | select(.type == "user" and (.message.content | type) == "string")][0].message.content | length) as $prompt
  | ([$all[] | select(.timestamp != null)][0] | ts) as $began
  | "first turn\t\($turns[0] | ctx) tokens\t(system prompt, skills listed, session start \($start) B, the brief \($prompt) B)",
    "first act\t\(if $at then ([$before[] | select(.type == "assistant" and ctx > 0)] | last | ctx | tostring) + " tokens" else "none" end)\t\(if $at then ($all[$at].timestamp[11:19]) + ", " + (((($all[$at] | ts) - $began) / 60 | floor) | tostring) + " min after the start" else "" end)",
    "read before it\t\($reads | map(.bytes) | add // 0) B in \($reads | length) results",
    "at the end\t\($turns | last | ctx) tokens\tmost \($turns | map(ctx) | max) tokens, \($turns | length) turns",
    ($reads | sort_by(-.bytes) | .[0:12][] | "  \(.bytes) B\t\(.what)")
' "$t"

# What the session was given at its start and never used in its whole run - the skills listed, the agents
# listed, the deferred tools and connectors, the first prompt's hook - so that a role's card and its
# settings can be trimmed to what the role uses (decision 2026-11-17-start-health-folds-into-housekeeping, 2026-11-17-role-health-is-the-patrols).
jq -rs '
  def sized: if type == "string" then length else (tostring | length) end;
  . as $all
  | [$all[] | select(.type == "assistant") | .message.content[]? | select(.type == "tool_use")] as $uses
  | ($uses | map(select(.name == "Skill") | .input.skill) | unique) as $skills
  | ($uses | map(select(.name == "Agent") | (.input.subagent_type // "general-purpose")) | unique) as $agents
  | ($uses | map(select(.name | startswith("mcp__")) | .name | split("__")[1]) | unique) as $servers
  | ($uses | map(select(.name == "ToolSearch")) | length) as $searched
  | ([$all[] | select(.attachment.type == "skill_listing")][0].attachment.content // "") as $listing
  | ([$listing | split("\n- ")[] | capture("^-? ?(?<n>\\S+?):(\\s|$)") as $m | {n: $m.n, b: (length + 3)}]) as $entries
  | ([$all[] | select(.attachment.type == "agent_listing_delta") | .attachment | sized] | add // 0) as $agentb
  | ([$all[] | select(.attachment.type == "deferred_tools_delta") | .attachment | sized] | add // 0) as $deferredb
  | ([$all[] | select(.type == "attachment" and .attachment.hookEvent == "UserPromptSubmit") | .attachment.content | sized] | .[0] // 0) as $role
  | ($entries | map(select(.n as $n | $skills | index($n) | not))) as $unused
  | "given, not used",
    "skills listed\t\($entries | length) skills, \($listing | length) B\tused: \(if $skills == [] then "none" else $skills | join(", ") end)",
    ($unused | group_by(.n | if test(":") then split(":")[0] else "(Claude Code)" end)
      | map({src: (.[0].n | if test(":") then split(":")[0] else "(Claude Code)" end), b: (map(.b) | add), k: length})
      | sort_by(-.b)[] | "  unused \(.b) B\t\(.src), \(.k) skills"),
    "agents listed\t\($agentb) B\tused: \(if $agents == [] then "none" else $agents | join(", ") end)",
    "deferred tools\t\($deferredb) B\tsearched \($searched) times; connectors used: \(if $servers == [] then "none" else $servers | join(", ") end)",
    "first prompt\t\($role) B\tthe role card and its practices, or every practice"
' "$t"

# What the session struggled with while working - the calls that failed (grouped by what they said), the
# hook refusals among them, the commands run again unchanged, and SQL written by hand where a named record or
# query was meant - so that a better tool, a skill or a removed step can be proposed (decision
# 2026-11-17-role-health-is-the-patrols).
jq -rs '
  def text: if type == "string" then . elif type == "array" then map(.text? // "") | join("\n") else tostring end;
  def said: (text | split("\n") | map(select(test("^Exit code [0-9]+$") | not) | select(length > 0))) as $l
      | (([$l[] | select(test("error|refus|not (a|one|found|allowed|declared)|fail|denied|unknown|invalid|cannot|no such"; "i"))][0]) // $l[0] // "")
      | gsub("[0-9]+"; "N") | gsub("/tmp/[^ ]*"; "/tmp/...") | .[0:90];
  . as $all
  | ([$all[] | select(.type == "assistant") | .message.content[]? | select(.type == "tool_use")
      | {key: .id, value: {name, cmd: ((.input.command // .input.file_path // .input.skill // "") | tostring)}}] | from_entries) as $use
  | [$all[] | select(.type == "user") | .message.content | arrays | .[] | select(.type == "tool_result")
      | {id: .tool_use_id, err: (.is_error == true), said: (.content | said)}] as $results
  | ($results | map(select(.err))) as $failed
  | ([$use[] | select(.name == "Bash") | .cmd] | group_by(.) | map(select(length > 1) | {cmd: .[0], n: length})) as $again
  | ([$use[] | select(.name == "Bash") | .cmd
      | select(test("tad sql .?(INSERT|UPDATE|DELETE)|(duckdb|sqlite3|psql) [^|]*(INSERT|UPDATE|DELETE)"; "i"))] | length) as $sql
  | "struggled with",
    "calls\t\($results | length) results, \($failed | length) failed (\(if ($results | length) > 0 then (100 * ($failed | length) / ($results | length) | floor) else 0 end)%)\t\($failed | map(select(.said | test("hook|refused"; "i"))) | length) refused by a hook",
    ($failed | group_by(($use[.id].name // "?") + "\t" + .said) | map({k: .[0], n: length}) | sort_by(-.n) | .[0:8][]
      | "  \(.n)x\t\($use[.k.id].name // "?")\t\(.k.said)"),
    "run again unchanged\t\($again | map(.n - 1) | add // 0) times\t\($again | sort_by(-.n) | .[0:3] | map("\(.n)x \(.cmd | gsub("\n"; " ") | .[0:50])") | join("; "))",
    "SQL by hand\t\($sql) commands\twhere a named record or query was meant"
' "$t"
