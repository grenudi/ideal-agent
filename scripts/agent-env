# agent-env - the neutral start of an agent's shell, sourced (`. agent-env`), never run: what every session
# and job needs to work on the commons, and nothing of ocoeco (decision 2026-11-17-a-neutral-start).
# In a Claude Code session with the ideal-agent plugin it is sourced before every Bash command by itself
# (the session start names it in CLAUDE_ENV_FILE); a job outside Claude Code sources it from a clone:
#   . ~/Projects/grenudi/ideal-agent/scripts/agent-env
#
#   AGENT_NAME     who signs the work: the role name (the brief's `Name:` line, `<place>-<role>`, else the
#                  role) and this run's id - six hex characters of the session's id - as `surya-keeper.3f9a2c`;
#                  given, it is kept. It is the commits' author name; the email is the owner's, plus-tagged
#                  with the name (`owner+surya-keeper.3f9a2c@host`), so mail reaches the owner and a squash
#                  merge keeps the name as a Co-authored-by trailer (decision 2026-11-18-a-run-signs-as-role-and-run)
#   GH_TOKEN       the GitHub token, where ~/.config/ideal-agent/token is (mode 600, never in a repository)
#   PATH           ~/.local/bin (land, tad, ikb, devlab) and ~/.cargo/bin first
#   branch NAME    branch first, in a worktree of your own: a new branch NAME from origin/main, checked out under
#                  ~/.local/share/agent-worktrees/REPO/NAME, and you moved there - the shared clone is never
#                  written (the guard refuses it; decision 2026-11-18-sessions-write-in-their-own-worktree)
#   land           land the current branch: its PR, every check, the merge, main read back (lab-machine's land)

case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
case ":$PATH:" in *":$HOME/.cargo/bin:"*) ;; *) PATH="$HOME/.cargo/bin:$PATH" ;; esac
export PATH
[ -n "${GH_TOKEN:-}" ] || { [ -r "$HOME/.config/ideal-agent/token" ] && GH_TOKEN=$(cat "$HOME/.config/ideal-agent/token") && export GH_TOKEN; }

if [ -z "${AGENT_NAME:-}" ]; then
    _ia_state="${XDG_STATE_HOME:-$HOME/.local/state}/ideal-agent/sessions/${CLAUDE_CODE_SESSION_ID:-none}"
    if [ -r "$_ia_state" ]; then
        AGENT_NAME=$(sed -n 's/^name //p' "$_ia_state" | head -n 1)
        [ -n "$AGENT_NAME" ] || AGENT_NAME=$(sed -n 's/^role //p' "$_ia_state" | head -n 1)
    fi
    unset _ia_state
    AGENT_NAME=${AGENT_NAME:-agent}
    _ia_run=$(printf '%s' "${CLAUDE_CODE_SESSION_ID:-}" | tr -dc '0-9a-f' | cut -c1-6)
    [ -z "$_ia_run" ] || AGENT_NAME="$AGENT_NAME.$_ia_run"
    unset _ia_run
fi
export AGENT_NAME
export GIT_AUTHOR_NAME="$AGENT_NAME" GIT_COMMITTER_NAME="$AGENT_NAME"
if [ -z "${GIT_AUTHOR_EMAIL:-}" ]; then
    _ia_owner=$(git config --global user.email 2>/dev/null || true)
    case "$_ia_owner" in
        *@*) GIT_AUTHOR_EMAIL="${_ia_owner%%@*}+$AGENT_NAME@${_ia_owner#*@}" ;;
        *) GIT_AUTHOR_EMAIL="agent@creation-guidelines" ;;
    esac
    unset _ia_owner
fi
export GIT_AUTHOR_EMAIL GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-$GIT_AUTHOR_EMAIL}"
# a release pull request is landed on its own (land --release), not with every change
export LAND_RELEASE="${LAND_RELEASE:-0}"

branch() {
    [ $# -eq 1 ] || { echo "usage: branch NAME" >&2; return 2; }
    git rev-parse --git-dir > /dev/null 2>&1 || { echo "branch: not in a clone" >&2; return 1; }
    _ia_top=$(git rev-parse --path-format=absolute --git-common-dir); _ia_top=${_ia_top%/.git}
    _ia_dir="${AGENT_WORKTREES:-$HOME/.local/share/agent-worktrees}/$(basename "$_ia_top")/$1"
    git -C "$_ia_top" fetch -q origin && git -C "$_ia_top" worktree add -q -b "$1" "$_ia_dir" origin/main &&
        cd "$_ia_dir" && echo "on $1 in $_ia_dir (a worktree of your own), from origin/main $(git rev-parse --short HEAD)"
    unset _ia_top _ia_dir
}
