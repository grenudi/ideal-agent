#!/bin/sh
# Fails while the lab still runs the job route (decision 2026-11-18-job-route-retires-next): lab-agent's or
# oco-agent's daemon active, or anything polling the jobs repo. Passes when long jobs are `systemd-run --user`
# units only. Usage: scripts/lab-agent-route-free   (exit 0 when the route is gone, 1 while any part is up)
set -u
n=0
for u in lab-agent.service oco-agent.service; do
	if systemctl --user is-active --quiet "$u" 2>/dev/null; then echo "still up: $u"; n=$((n + 1)); fi
done
polling=$(pgrep -af 'lab-agent run|oco-agent run' 2>/dev/null | grep -v pgrep | wc -l)
[ "$polling" -eq 0 ] || { echo "still polling the jobs repo: $polling process(es)"; n=$((n + 1)); }
echo "the job route has $n part(s) still up"
[ "$n" -eq 0 ]
