#!/bin/sh
# Shows broken until nothing the lab depends on needs lab-agent (decision 2026-11-17-lab-agent-retires-by-parts):
# first the live uses - words in the plugin's code, the lab's units, setup and tools, the token path; then the job
# route - lab-agent's or oco-agent's daemon active, or anything polling the jobs repo (decision
# 2026-11-18-job-route-retires-next). lab-tools is scanned so a regrowth shows.
# Usage: scripts/lab-agent-free   (exit 0 when none is left and the route is gone, 1 while any is)
set -u
here=$(cd "$(dirname "$0")/.." && pwd)
P="${PROJECTS:-$HOME/Projects}"
n=0
for f in "$here/src" "$here/hooks" "$here/scripts/agent-env" "$here/skills" \
         "$P/lab-machine/bin" "$P/lab-machine/systemd" "$P/lab-machine/setup" \
         "$P/linux-phone-oco/lab-tools/devlab/src" "$P/linux-phone-oco/lab-tools/host/src"; do
  [ -e "$f" ] || { echo "not known yet: $f is not here"; continue; }
  c=$(grep -rIn 'lab-agent' "$f" 2>/dev/null | wc -l)
  [ "$c" -eq 0 ] || echo "$c  $f"
  n=$((n + c))
done
echo "lab-agent is still named $n times by what the lab runs"
up=0
for u in lab-agent.service oco-agent.service; do
  if systemctl --user is-active --quiet "$u" 2>/dev/null; then echo "still up: $u"; up=$((up + 1)); fi
done
polling=$(pgrep -af 'lab-agent run|oco-agent run' 2>/dev/null | grep -v pgrep | wc -l)
[ "$polling" -eq 0 ] || { echo "still polling the jobs repo: $polling process(es)"; up=$((up + 1)); }
echo "the job route has $up part(s) still up"
[ "$n" -eq 0 ] && [ "$up" -eq 0 ]
