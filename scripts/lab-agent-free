#!/bin/sh
# Shows broken until nothing the lab depends on needs lab-agent (decision 2026-11-17-lab-agent-retires-by-parts):
# first the live uses - words in the plugin's code and in the lab's tools, units and setup as their origin/main has
# them (a shared clone's tree may be behind: decision 2026-11-19-roles-act-on-origin-main); then the job route -
# lab-agent's or oco-agent's daemon active, or anything polling the jobs repo (stopped 2026-11-20: backlog
# lab-agent-3-jobs-by-systemd-run done). Both stay checked so a regrowth shows.
# Usage: scripts/lab-agent-free   (exit 0 when none is left and the route is gone, 1 while any is)
set -u
here=$(cd "$(dirname "$0")/.." && pwd)
P="${PROJECTS:-$HOME/Projects}"
n=0
for f in "$here/src" "$here/hooks" "$here/scripts/agent-env" "$here/skills"; do
  c=$(grep -rIn 'lab-agent' "$f" 2>/dev/null | wc -l)
  [ "$c" -eq 0 ] || echo "$c  $f"
  n=$((n + c))
done
for rp in lab-machine:bin lab-machine:systemd lab-machine:setup \
          linux-phone-oco/lab-tools:devlab/src linux-phone-oco/lab-tools:host/src; do
  r="$P/${rp%%:*}"; p=${rp#*:}
  git -C "$r" rev-parse -q --verify refs/remotes/origin/main > /dev/null 2>&1 || { echo "not known yet: $r is not here"; continue; }
  c=$(git -C "$r" grep -In 'lab-agent' refs/remotes/origin/main -- "$p" 2>/dev/null | wc -l)
  [ "$c" -eq 0 ] || echo "$c  $r/$p (origin/main)"
  n=$((n + c))
done
echo "lab-agent is still named $n times by what the lab runs"
up=0
for u in lab-agent.service oco-agent.service; do
  if systemctl --user is-active --quiet "$u" 2>/dev/null; then echo "still up: $u"; up=$((up + 1)); fi
done
polling=$(pgrep -f '[l]ab-agent run|[o]co-agent run' 2>/dev/null | wc -l)
[ "$polling" -eq 0 ] || { echo "still polling the jobs repo: $polling process(es)"; up=$((up + 1)); }
echo "the job route has $up part(s) still up"
[ "$n" -eq 0 ] && [ "$up" -eq 0 ]
