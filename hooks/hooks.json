{
  "description": "The ways held when they are tried: no git push to main, no Python; the practices and the inbox at every session start.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/ideal-agent\" start", "timeout": 600 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/ideal-agent\" guard", "timeout": 10 }
        ]
      }
    ]
  }
}
